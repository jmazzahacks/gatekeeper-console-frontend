# ==============================================================================
# Frontend env — local dev only.
# ==============================================================================
#
# Tenant-specific URLs and branding (Aegis API URL, site name, site domain) are
# served by the gatekeeper backend at GET /api/config and fetched in the
# browser at first paint. They are NOT baked at build time anymore — a single
# image can deploy across tenants. To change them, set SITE_NAME / SITE_DOMAIN
# / AEGIS_API_URL on the gatekeeper backend.

# When set, the Next.js dev server proxies /api/* (admin, auth, config) to
# this URL. Use this to develop against a remote gatekeeper backend without
# fighting CORS preflights from localhost:3000.
# DEV_GATEKEEPER_PROXY=https://gatekeeper.example.com

# DEBUG_LOCAL=true sends logs to stdout. Omit or set to false to send to Loki.
DEBUG_LOCAL=true

# Loki logging (production only — required when DEBUG_LOCAL=false)
#
# NAMING NOTE: the gatekeeper-backend repo currently reads slightly different
# names (LOKI_ENDPOINT / LOKI_PASSWORD / LOKI_CA_BUNDLE_PATH). Same Loki
# credentials, two different var names per side — must be set twice if you
# log both. Tracked for normalization.
# LOKI_URL=https://loki.example.com
# LOKI_USER=
# LOKI_PASS=
# LOKI_CA_PATH=
